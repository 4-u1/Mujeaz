# Copy to .env (repo root for docker compose, or backend/.env for local runs).

# Optional — enables live AI. Without it the API returns clearly labelled fallback output.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Database
POSTGRES_PASSWORD=postgres
MUJEAZ_APP_DB_PASSWORD=mujeaz_app
MUJEAZ_OWNER_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mujeaz
MUJEAZ_DATABASE_URL=postgresql+psycopg://mujeaz_app:mujeaz_app@localhost:5432/mujeaz

# Auth (ADR 0003). The dev identity provider must be disabled in production.
MUJEAZ_ENV=development
MUJEAZ_DEV_AUTH=true
# MUJEAZ_JWT_PRIVATE_KEY_PEM=        # persist tokens across restarts
# MUJEAZ_JWKS_URL=                   # use an external OIDC provider instead
# MUJEAZ_JWT_ISSUER=mujeaz-dev-idp
# MUJEAZ_JWT_AUDIENCE=mujeaz-api
